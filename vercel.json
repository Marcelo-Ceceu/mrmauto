{
  "build": {
    "env": {
      "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
    }
  },
  "env": {
    "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mrmauto-source.vercel.app"
        }
      ],
      "destination": "https://mrmautomoveis.com.br/:path*",
      "permanent": true
    }
  ]
}
